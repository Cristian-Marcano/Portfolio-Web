      rel="stylesheet"
    />

    <!-- Viewport scaling: keeps the design proportional on large monitors (>1920px). -->
    <!-- On mobile (< 768px), scaling is always disabled so responsive CSS takes over. -->
    <script is:inline>
      (function () {
        const STANDARD_WIDTH = 1920; // The viewport width the design was built for
        const MOBILE_BREAKPOINT = 768; // Below this, never scale — let CSS handle it

        function applyScale() {
          const width = window.innerWidth;
          const root = document.documentElement;

          if (width >= MOBILE_BREAKPOINT && width > STANDARD_WIDTH) {
            const scale = width / STANDARD_WIDTH;
            root.style.setProperty('--app-scale', scale);
            root.style.zoom = scale;
          } else {
            root.style.setProperty('--app-scale', 1);
            root.style.zoom = 1;
          }
        }

        applyScale();
        window.addEventListener('resize', applyScale);
      })();
    </script>
  </head>
