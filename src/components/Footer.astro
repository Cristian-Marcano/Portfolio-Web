---
import "../styles/footer.css";
import { FOOTER_NAV_LINKS, SOCIAL_LINKS } from "../data/site-config";
import type { Language } from "../data/site-config";

const lang = (Astro.currentLocale ?? "es") as Language;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__corner" aria-hidden="true"></div>

  <section class="site-footer__body">
    <!-- Left column: social icon links (mirrors header) -->
    <nav class="site-footer__social-nav" aria-label="Social links">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith("mailto") ? undefined : "_blank"}
            rel="noopener noreferrer"
            aria-label={link.name}
            class="site-footer__social-link"
          >
            <span class="site-footer__social-icon">
              <link.icon />
            </span>
          </a>
        ))
      }
    </nav>

    <!-- Right column: nav links row + main info block -->
    <div class="site-footer__right">
      <!-- Nav links row (mirrors header nav) -->
      <nav class="site-footer__nav" aria-label="Footer navigation">
        {
          FOOTER_NAV_LINKS.map((link) => (
            <a href={link.href} class="site-footer__nav-link">
              <span class="site-footer__nav-text">
                <span class="site-footer__nav-bracket" aria-hidden="true">
                  &lt;
                </span>
                {link.name[lang]}
                <span class="site-footer__nav-bracket" aria-hidden="true">
                  /&gt;
                </span>
              </span>
            </a>
          ))
        }
        <!-- Filler to stretch last nav items -->
        <div class="site-footer__nav-filler" aria-hidden="true"></div>
      </nav>

      <!-- Main info block: copyright + La Fin -->
      <div class="site-footer__info">
        <div class="site-footer__meta">
          <p class="site-footer__copyright">
            CRISTIAN MARCANO &copy; {currentYear}
          </p>
          <p class="site-footer__tagline">ALL LEFTS UNRESERVED</p>
        </div>
        <p class="site-footer__fin" aria-hidden="true">
          La <span class="site-footer__fin-italic">Fin</span><span
            class="site-footer__fin-dot">.</span
          >
        </p>
      </div>
    </div>
  </section>

  <div class="site-footer__corner" aria-hidden="true"></div>
</footer>
