---
// Main Hero Wrapper
import HeroTextColumn from "./HeroTextColumn.astro";
import HeroIllustrationColumn from "./HeroIllustrationColumn.astro";
import HeroRecentWork from "./HeroRecentWork.astro";
import HeroConnector from "./HeroConnector.astro";
import HeroNarratorNote from "./HeroNarratorNote.astro";
import "../../styles/hero-layout.css";
---

<section class="hero" id="home">
  <!-- Left extreme -->
  <div class="hero__corner"></div>

  <!-- Middle content container (Row on desktop) -->
  <section class="hero__content">
    <!-- LEFT COLUMN -->
    <section class="hero__column hero__column--left">
      <!-- Title, Intro, Narrator, Time -->
      <HeroTextColumn />

      <!-- Recent Work -->
      <HeroRecentWork />
    </section>

    <!-- RIGHT COLUMN -->
    <section class="hero__column hero__column--right">
      <!-- Profile Illustration & Terminal -->
      <HeroIllustrationColumn />

      <!-- Connector (Arrow Down + Chest Window) -->
      <HeroConnector />

      <!-- Narrator's Note -->
      <HeroNarratorNote />
    </section>
  </section>

  <!-- Right extreme -->
  <div class="hero__corner"></div>
</section>
