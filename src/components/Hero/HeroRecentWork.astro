---
// Unified Component File but visually separate bento cells
import ArrowTitle from "../ui/ArrowTitle.astro";
import CornerGrid from "../../assets/corner-grid.svg";
import Plus from "../../assets/plus.svg";
import NumberZero from "../../assets/number-0.svg";
import NumberOne from "../../assets/number-1.svg";
import NumberTwo from "../../assets/number-2.svg";
import NumberThree from "../../assets/number-3.svg";
import NumberFour from "../../assets/number-4.svg";
import NumberFive from "../../assets/number-5.svg";
import NumberSix from "../../assets/number-6.svg";
import NumberSeven from "../../assets/number-7.svg";
import NumberEight from "../../assets/number-8.svg";
import NumberNine from "../../assets/number-9.svg";
import DigitanAgency from "../../assets/digitan-agency.webp";
import "../../styles/hero-recent-work.css";
import { HERO_CONTENT } from "../../data/hero";
import type { Language } from "../../data/hero";

const lang: Language = "es";

const numberMap = {
  "0": NumberZero,
  "1": NumberOne,
  "2": NumberTwo,
  "3": NumberThree,
  "4": NumberFour,
  "5": NumberFive,
  "6": NumberSix,
  "7": NumberSeven,
  "8": NumberEight,
  "9": NumberNine,
};

const startDate = new Date("2022-03-15T00:00:00");
const today = new Date();

let expYears = today.getFullYear() - startDate.getFullYear();
let expMonths = today.getMonth() - startDate.getMonth();

if (today.getDate() < startDate.getDate()) {
  expMonths--;
}

if (expMonths < 0) {
  expYears--;
  expMonths += 12;
}

const showPlus = expMonths > 5;
const expYearsDigits = expYears.toString().split("");
---

<section class="hero__bento-cell">
  <CornerGrid class="hero__corner-grid hero__corner-grid--top" />
  <!-- LEFT (Top in this column): Metrics -->
  <article class="hero__metrics-cell">
    <div class="hero__recent-metric-item">
      <h4 class="hero__recent-label">{HERO_CONTENT.recentWork.metrics.projects[lang]}</h4>
      <div class="hero__recent-number">
        <NumberOne />
        <NumberSix />
      </div>
    </div>
    <div class="hero__recent-metric-item">
      <h4 class="hero__recent-label">{HERO_CONTENT.recentWork.metrics.experience[lang]}</h4>
      <div class="hero__recent-number">
        {showPlus && <Plus />}
        {
          expYearsDigits.map((digit) => {
            const DigitComponent = numberMap[digit as keyof typeof numberMap];
            return <DigitComponent />;
          })
        }
      </div>
    </div>
  </article>

  <!-- LEFT (Bottom in this column): Recent Work Thumbnail & Info -->
  <article class="hero__recent-project-cell has-arrow-title">
    <h4 class="hero__recent-header">{HERO_CONTENT.recentWork.header[lang]}</h4>

    <div class="hero__recent-img-wrapper">
      <div class="hero__recent-img-container">
        <img
          src={DigitanAgency.src}
          alt={HERO_CONTENT.recentWork.project.title}
          class="hero__recent-img"
        />
      </div>
    </div>

    <div class="hero__recent-info">
      <ArrowTitle
        text={HERO_CONTENT.recentWork.project.title}
        headingTag="h3"
        className="hero__recent-title"
      />

      <div class="hero__recent-meta">
        <span class="hero__recent-role">{HERO_CONTENT.recentWork.project.role[lang]}</span>
        <span class="hero__recent-badge">{HERO_CONTENT.recentWork.project.modality[lang]}</span>
      </div>

      <p class="hero__recent-period">{HERO_CONTENT.recentWork.project.period[lang]}</p>

      <p class="hero__recent-description">
        {HERO_CONTENT.recentWork.project.description[lang]}
      </p>
    </div>
  </article>
  <CornerGrid class="hero__corner-grid hero__corner-grid--bottom-right" />
</section>

<style>
  .hero__recent-number :global(svg rect) {
    opacity: 1;
    transition: opacity 0.3s ease;
    /* Evita que el rect atrape eventos de puntero individuales si es necesario, pero necesitamos mousemove en el contenedor */
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const containers = document.querySelectorAll<HTMLDivElement>(
      ".hero__recent-number",
    );

    containers.forEach((container) => {
      const rects = container.querySelectorAll<SVGRectElement>("svg rect");
      const baseOpacity = 1;
      const minOpacity = 0.1;
      const maxDist = 45;

      let lastMouseX = 0;
      let lastMouseY = 0;
      let isHovering = false;

      container.addEventListener("mousemove", (e: MouseEvent) => {
        isHovering = true;
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;

        rects.forEach((rect: SVGRectElement) => {
          if (rect.dataset.waveTimeout1)
            clearTimeout(Number(rect.dataset.waveTimeout1));
          if (rect.dataset.waveTimeout2)
            clearTimeout(Number(rect.dataset.waveTimeout2));

          const rectBounds = rect.getBoundingClientRect();
          const rectCenterX = rectBounds.left + rectBounds.width / 2;
          const rectCenterY = rectBounds.top + rectBounds.height / 2;

          const distance = Math.hypot(
            lastMouseX - rectCenterX,
            lastMouseY - rectCenterY,
          );

          let opacity = minOpacity;
          if (distance < maxDist) {
            // El más cercano es 1, los lejanos bajan hasta minOpacity
            opacity = 1 - (distance / maxDist) * (1 - minOpacity);
          }

          rect.style.transition = "opacity 0.1s ease-out";
          rect.style.opacity = opacity.toString();
        });
      });

      container.addEventListener("mouseleave", () => {
        isHovering = false;

        const containerBounds = container.getBoundingClientRect();

        rects.forEach((rect: SVGRectElement) => {
          const rectBounds = rect.getBoundingClientRect();
          const rectCenterY = rectBounds.top + rectBounds.height / 2;

          // Distancia vertical desde la parte superior del contenedor
          const y = rectCenterY - containerBounds.top;

          // Delay basado únicamente en el eje Y para que la ola sea de arriba hacia abajo
          const delay = y * 6;

          rect.style.transition = `opacity 0.2s ease-out`;

          // La opacidad baja para crear la "sombra" de la ola
          const t1 = setTimeout(() => {
            if (isHovering) return;
            rect.style.opacity = minOpacity.toString();
          }, delay);

          // Después de un instante (que equivale a 2-3 líneas de altura temporal), regresa a 1
          const t2 = setTimeout(() => {
            if (isHovering) return;
            rect.style.opacity = baseOpacity.toString();
          }, delay + 120);

          rect.dataset.waveTimeout1 = t1.toString();
          rect.dataset.waveTimeout2 = t2.toString();
        });
      });
    });
  });
</script>
