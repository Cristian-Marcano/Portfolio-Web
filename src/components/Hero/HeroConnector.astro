---
import Arrow from "../../assets/arrow.svg";
import HeroGameIlustration from "../../assets/dev-illustration.webp";
import "../../styles/hero-connector.css";
---

<section class="hero__connector">
  <!-- Left Cell: Arrow Down -->
  <div class="hero__connector-arrow-cell">
    <div class="hero__connector-arrow">
      <Arrow />
    </div>
  </div>

  <!-- Right Cell: Chest Window -->
  <div class="hero__connector-chest-cell">
    <div class="hero__connector-chest-wrapper">
      <img
        src={HeroGameIlustration.src}
        alt="Game illustration"
        class="hero__chest-illustration"
        fetchpriority="high"
        loading="eager"
      />
    </div>
  </div>
</section>
