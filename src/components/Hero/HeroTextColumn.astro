---
import myAvatarGif from "../../assets/MyAvatarForMyWebsite.gif";
import Star from "../../assets/star.svg";
import "../../styles/hero-text.css";
import { HERO_CONTENT } from "../../data/hero";
import type { Language } from "../../data/site-config";

const lang = (Astro.currentLocale ?? "es") as Language;
---

<article class="hero__text-column">
  <!-- Title -->
  <h1 class="hero__title">
    {HERO_CONTENT.textColumn.title.line1[lang]}<span class="hero__title-accent"
      >{HERO_CONTENT.textColumn.title.accent1[lang]}</span
    >{HERO_CONTENT.textColumn.title.line2[lang]}
    <br class="hero__title-break" />
    <span class="hero__title-accent">
      {HERO_CONTENT.textColumn.title.accent2[lang]}
    </span>
    <span class="hero__title-dot">.</span>
  </h1>

  <!-- Intro Paragraph -->
  <h2 class="hero__intro">
    {HERO_CONTENT.textColumn.intro.greeting[lang]}<span
      class="hero__intro-highlight"
    >
      {HERO_CONTENT.textColumn.intro.name}
    </span>
    {HERO_CONTENT.textColumn.intro.description[lang]}<span
      class="hero__intro-muted"
      >{HERO_CONTENT.textColumn.intro.muted[lang]}</span
    >
  </h2>

  <!-- Bottom Row: Narrator & Time -->
  <footer class="hero__footer">
    <h2 class="hero__narrator">
      <strong class="hero__narrator-highlight"
        >{HERO_CONTENT.textColumn.narrator.label[lang]}</strong
      >
      {HERO_CONTENT.textColumn.narrator.text[lang]}
      <span class="hero__cursor">▌</span>
    </h2>

    <div class="hero__time-wrapper">
      <div class="hero__spinner">
        <Star />
      </div>
      <h3 class="hero__time">
        {HERO_CONTENT.textColumn.timeLabel[lang]}
        <span class="hero__time-value" id="local-time-value"> 00:00</span>
      </h3>
      <h3 class="hero__time-zone">UTC -04</h3>
    </div>
  </footer>

  <!-- Mascot / Pixel Art Animated Character -->
  <div class="hero__mascot">
    <img
      src={myAvatarGif.src}
      alt="Cristian Marcano Pixel Mascot"
      class="hero__mascot-img"
    />
  </div>
</article>

<script>
  function updateTime() {
    const timeElement = document.getElementById("local-time-value");
    if (!timeElement) return;

    // Get time in Caracas, Venezuela (UTC-4)
    const options: Intl.DateTimeFormatOptions = {
      timeZone: "America/Caracas",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    };

    const formatter = new Intl.DateTimeFormat("en-US", options);
    timeElement.textContent = formatter.format(new Date());
  }

  // Update immediately
  updateTime();

  // Update every second to catch minute changes precisely
  setInterval(updateTime, 1000);
</script>
