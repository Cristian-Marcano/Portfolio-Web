---
import LabelRow from "../ui/LabelRow.astro";
import "../../styles/about-underground.css";
import { ABOUT_SECTION } from "../../data/about";
import type { Language } from "../../data/site-config";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = ABOUT_SECTION.skills;
---

<section class="about__block-row">
  <article class="about__block about__block--skills hover-group">
    <LabelRow
      text={t.label[lang]}
      isAnimated={true}
      headingTag="h3"
      className="about__label-row"
    />

    <ul class="about__skills-list">
      {
        t.items.map((skill) => (
          <li class={`about__skill-tag about__skill-tag--${skill.tier}`}>
            {skill.name}
          </li>
        ))
      }
    </ul>
  </article>

  <!-- Decorative green side cell -->
  <div class="about__decorative-cell" aria-hidden="true"></div>
</section>
