---
import LabelRow from "../ui/LabelRow.astro";
import "../../styles/about-objective.css";
import { ABOUT_SECTION } from "../../data/about";
import type { Language } from "../../data/site-config";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = ABOUT_SECTION.objective;
---

<article class="about__block about__block--objective hover-group">
  <LabelRow
    text={t.label[lang]}
    isAnimated={true}
    headingTag="h3"
    className="about__label-row"
  />
  <p class="about__objective-text" aria-label={t.ariaLabel[lang]}>
    {
      lang === "es" ? (
        <>
          Trabajar de forma{" "}
          <em class="about__objective-italic">interdisciplinaria</em> con
          distintos equipos<span class="about__objective-comma">, </span>
          <em class="about__objective-italic">auditando</em> y traduciendo
          <em class="about__objective-italic"> requerimientos </em>
          complejos en productos escalables
          <span class="about__objective-comma">, </span>seguros y eficientes
          <span class="about__objective-period">.</span>
        </>
      ) : (
        <>
          Work <em class="about__objective-italic">cross-functionally </em>
          across teams<span class="about__objective-comma">, </span> auditing
          <span class="about__objective-comma">, </span>translating complex
          business
          <em class="about__objective-italic"> requirements </em>into scalable
          <span class="about__objective-comma">,</span> secure
          <span class="about__objective-comma">, </span>and efficient products
          <span class="about__objective-period">.</span>
        </>
      )
    }
  </p>
</article>
