---
import "../../styles/about-lists.css";
import { ABOUT_SECTION } from "../../data/about";
import type { Language } from "../../data/site-config";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = ABOUT_SECTION.hopesTo;
---

<article class="about__list-card">
  <h3 class="about__list-title">{t.title[lang]}</h3>
  <ul class="about__list">
    {
      t.goals[lang].map((goal) => (
        <li class="about__list-item">
          <div class="about__list-icon" aria-hidden="true">
            {goal.done ? (
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  width="18"
                  height="18"
                  rx="3"
                  fill="var(--color-accent)"
                />
                <path
                  d="M4 9l3.5 3.5L14 6"
                  stroke="white"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            ) : (
              <svg
                width="18"
                height="18"
                viewBox="0 0 18 18"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <rect
                  x="0.5"
                  y="0.5"
                  width="17"
                  height="17"
                  rx="2.5"
                  stroke="var(--color-border-grid)"
                  stroke-width="1.2"
                />
              </svg>
            )}
          </div>
          <p
            class={`about__list-text ${goal.done ? "about__list-text--checked" : ""}`}
          >
            {goal.text}
          </p>
        </li>
      ))
    }
  </ul>
</article>
