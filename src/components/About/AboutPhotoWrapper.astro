---
import { Image } from "astro:assets";
import myPhoto from "../../assets/me-irl.webp";
import ArrowTitle from "../ui/ArrowTitle.astro";
import "../../styles/about-photo-wrapper.css";
import { ABOUT_SECTION } from "../../data/about";
import type { Language } from "../../data/site-config";
import { PERSONAL_LINKS } from "../../data/site-config";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = ABOUT_SECTION.photo;
---

<!-- Photo row: lego dots | photo card | right decorative cell -->
<section class="about__photo-row">
  <div class="about__photo-left-cell" aria-hidden="true"></div>

  <!-- Photo card (~404px, padding 21px) -->
  <div class="about__photo-card">
    <div class="about__photo-wrapper">
      <Image
        class="about__photo"
        src={myPhoto}
        alt={t.alt[lang]}
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Slideshow-style progress control bar -->
    <!-- <div class="about__photo-controls">
      <button class="about__play-btn" aria-label="Play slideshow" type="button">
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </button>
      <div
        class="about__progress-track"
        role="progressbar"
        aria-valuenow="0"
        aria-valuemin="0"
        aria-valuemax="100"
      >
        <div class="about__progress-fill"></div>
      </div>
    </div> -->
  </div>

  <!-- Decorative green right cell (~136px wide) -->
  <div class="about__photo-right-cell" aria-hidden="true"></div>
</section>

<!-- Resume link -->
<a
  href={PERSONAL_LINKS.resume}
  target="_blank"
  rel="noopener noreferrer"
  class="about__resume-link has-arrow-title"
  aria-label={t.resume.ariaLabel[lang]}
>
  <ArrowTitle headingTag="p" className="about__resume-text">
    {t.resume.text[lang]}<span class="about__resume-highlight"
      >{t.resume.highlight[lang]}</span
    >
  </ArrowTitle>
</a>
