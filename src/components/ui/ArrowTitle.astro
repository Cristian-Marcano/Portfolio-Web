---
import Arrow from "../../assets/arrow.svg";
import "../../styles/arrow-title.css";

interface Props {
  text: string;
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  className?: string;
  containerClass?: string;
}

const { text, headingTag = "h3", className = "", containerClass = "" } = Astro.props;
const HeadingTag = headingTag;
---

<div class={`arrow-title-row ${containerClass}`}>
  <!-- SVG Arrow Left -->
  <div class="arrow-title__arrow">
    <Arrow />
  </div>

  <HeadingTag class={`arrow-title__text ${className}`}>
    {text}
  </HeadingTag>

  <!-- Hidden Arrow for symmetry -->
  <div class="arrow-title__arrow arrow-title__arrow--hidden">
    <Arrow />
  </div>
</div>
