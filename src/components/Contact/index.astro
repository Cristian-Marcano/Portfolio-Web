---
import SectionHeaderBlock from "../ui/SectionHeaderBlock.astro";
import ContactMessage from "./ContactMessage.astro";
import ContactEmailLink from "./ContactEmailLink.astro";
import ContactIllustration from "./ContactIllustration.astro";
import "../../styles/contact-layout.css";
import { CONTACT_SECTION } from "../../data/contact";
import type { Language } from "../../data/site-config";

const lang = (Astro.currentLocale ?? "es") as Language;
---

<section id="contact" class="contact" aria-label="Contact">
  <div class="contact__corner" aria-hidden="true"></div>

  <div class="contact__body">
    <!-- Left: text column -->
    <section class="contact__content">
      <SectionHeaderBlock
        title={CONTACT_SECTION.heading[lang]}
        class="contact__heading"
      />
      <ContactMessage lang={lang} />
      <ContactEmailLink lang={lang} />
    </section>

    <!-- Right: illustration column -->
    <section class="contact__media">
      <ContactIllustration />
    </section>
  </div>

  <div class="contact__corner" aria-hidden="true"></div>
</section>
