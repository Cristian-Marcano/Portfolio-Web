---
import "../../styles/work-mockups.css";
---

<div class="work__mockup-container">
  <div class="work__mockup-wrapper">
    
    <!-- Base mockup display area -->
    <div class="work__mockup-display">
      <div class="work__mockup-screen">
        <!-- Placeholder for the actual project screenshot -->
        <div class="work__mockup-placeholder">
          <span class="work__mockup-text">Hover over a project</span>
        </div>
      </div>
      
      <!-- Decorative elements to simulate a device or bento style -->
      <div class="work__mockup-base"></div>
    </div>
    
  </div>
</div>
