---
import CornerGrid from "../../assets/corner-grid.svg";
import Star from "../../assets/star.svg";
import ArrowTitle from "../ui/ArrowTitle.astro";
import SectionHeaderBlock from "../ui/SectionHeaderBlock.astro";
import "../../styles/work-projects.css";
import { PROJECTS, WORK_SECTION } from "../../data/projects";
import type { Language } from "../../data/site-config";

const lang = (Astro.currentLocale ?? "es") as Language;
---

<section class="work__projects-container">
  <header class="work__projects-header">
    <SectionHeaderBlock
      title={WORK_SECTION.title[lang]}
      description={WORK_SECTION.description[lang]}
      class="work__projects-heading"
    />
    <div class="work__projects-rounder">
      <CornerGrid class="work__rounder-path work__rounder-path--flipped" />
      <CornerGrid class="work__rounder-path" />
    </div>
  </header>

  <ul class="work__projects-list">
    {
      PROJECTS.map((project) => (
        <li>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`work__project has-arrow-title ${project.active ? "work__project--active has-arrow-title--active" : ""}`}
            data-project-id={project.id}
          >
            <ArrowTitle
              text={project.title[lang]}
              headingTag="h3"
              className="work__project-title"
            />

            <div class="work__project-description">
              <p>{project.description[lang]}</p>
            </div>

            <ul class="work__project-tags">
              {project.tags.map((tag, index) => (
                <li
                  class="work__project-tag"
                  style={`--star-delay: ${(index + 1) * 0.75}s`}
                >
                  <Star class="work__tag-star" />
                  {tag}
                </li>
              ))}
            </ul>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Project Hover Logic
    const projects = document.querySelectorAll(".work__project");

    projects.forEach((project) => {
      const activateProject = () => {
        projects.forEach((p) => {
          p.classList.remove(
            "work__project--active",
            "has-arrow-title--active",
          );
        });
        project.classList.add(
          "work__project--active",
          "has-arrow-title--active",
        );
      };

      project.addEventListener("mouseenter", activateProject);
      project.addEventListener("touchstart", activateProject, { passive: true });
      project.addEventListener("focus", activateProject);
    });
  });
</script>
