---
import linkedin from "../assets/linkedin.svg";
import email from "../assets/email.svg";
import instagram from "../assets/instagram.svg";
import resume from "../assets/resume.svg";

// Header component mimicking kashyaprayas.com using Tailwind CSS
// Using the "gap borders" technique: transparent gaps and rounded corners to reveal the parent background
const navLinks = [
  { name: "HOME", path: "/", active: true },
  { name: "WORK", path: "/work", active: false },
  { name: "ABOUT", path: "/about", active: false },
  { name: "CONTACT", path: "/contact", active: false },
];

const socialLinks = [
  {
    name: "LinkedIn",
    url: "https://linkedin.com",
    icon: linkedin,
  },
  {
    name: "Email",
    url: "mailto:hi@example.com",
    icon: email,
  },
  {
    name: "Instagram",
    url: "https://instagram.com",
    icon: instagram,
  },
  {
    name: "Resume",
    url: "#",
    icon: resume,
  },
];
---

<header class="flex w-full h-[50px] gap-[1px] pb-[1px] bg-border-grid">
  <!-- Left extreme line -->
  <div class="flex-grow bg-bg-main rounded-br-lg"></div>

  <!-- Middle content container -->
  <div class="w-full max-w-[1200px] flex gap-[1px]">
    <!-- Main navigation -->
    <nav class="flex flex-grow gap-[1px]" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.path}
            class={`group flex items-center justify-center px-8 text-[13px] font-medium tracking-[0.05em] transition-colors duration-200 no-underline rounded-b-lg
            ${
              link.active
                ? "bg-bg-main text-text-muted"
                : "bg-accent-bg text-accent hover:bg-bg-main hover:text-text-muted"
            }`}
            aria-current={link.active ? "page" : undefined}
          >
            <span
              class={`font-['Space_Mono',monospace] font-normal mx-1 transition-opacity duration-200 ${link.active ? "opacity-100" : "opacity-0 group-hover:opacity-100"} text-accent`}
              aria-hidden="true"
            >
              &lt;
            </span>
            {link.name}
            <span
              class={`font-['Space_Mono',monospace] font-normal mx-1 transition-opacity duration-200 ${link.active ? "opacity-100" : "opacity-0 group-hover:opacity-100"} text-accent`}
              aria-hidden="true"
            >
              /&gt;
            </span>
          </a>
        ))
      }
      <!-- Empty space filler -->
      <div class="flex-grow bg-bg-main rounded-b-lg"></div>
    </nav>

    <!-- Social links -->
    <div class="flex gap-[1px]">
      <nav class="flex gap-[1px]" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="group flex items-center justify-center w-[50px] transition-colors duration-200 no-underline rounded-b-lg bg-accent-bg text-accent hover:bg-bg-main hover:text-text-main"
            >
              <link.icon />
            </a>
          ))
        }
      </nav>
      <!-- Green block -->
      <div class="w-[60px] bg-accent rounded-b-lg"></div>
    </div>
  </div>

  <!-- Right extreme line -->
  <div class="flex-grow bg-bg-main rounded-bl-lg"></div>
</header>
