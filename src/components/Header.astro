---
import "../styles/header.css";
import { HEADER_NAV_LINKS, SOCIAL_LINKS } from "../data/site-config";
import type { Language } from "../data/site-config";

const lang = (Astro.currentLocale ?? "es") as Language;
---

<header class="site-header">
  <!-- Left extreme line -->
  <div class="site-header__corner site-header__corner--left"></div>

  <!-- Middle content container -->
  <section class="site-header__content">
    <!-- Main navigation (Left Column - 2/3) -->
    <nav class="site-header__main-nav" aria-label="Main navigation">
      {
        HEADER_NAV_LINKS.map((link) => (
          <a
            href={link.path}
            class={`site-header__nav-link ${link.active ? "site-header__nav-link--active" : ""}`}
            role="button"
            aria-current={link.active ? "page" : undefined}
          >
            <span class="site-header__nav-text">
              <span class="site-header__nav-brackets" aria-hidden="true">
                &lt;
              </span>
              {link.name[lang]}
              <span class="site-header__nav-brackets" aria-hidden="true">
                /&gt;
              </span>
            </span>
          </a>
        ))
      }
      <!-- Empty space filler -->
      <div class="site-header__nav-filler"></div>

      <!-- Language toggle -->
      <button
        id="lang-toggle"
        class="site-header__lang-btn"
        aria-label="Switch language"
        title="Switch language / Cambiar idioma"
        data-lang={lang}
      >
        <span class="site-header__lang-current" id="lang-current">ES</span>
        <span class="site-header__lang-sep" aria-hidden="true">/</span>
        <span class="site-header__lang-other" id="lang-other">EN</span>
      </button>
    </nav>

    <!-- Social links (Right Column - 1/3) -->
    <div class="site-header__social-container">
      <nav class="site-header__social-nav" aria-label="Social links">
        {
          SOCIAL_LINKS.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="site-header__social-link"
            >
              <span class="site-header__social-icon">
                <link.icon />
              </span>
            </a>
          ))
        }
      </nav>
      <!-- Green block filling the rest of the 1/3 column -->
      <div class="site-header__social-filler"></div>

      <!-- Empty margin cell -->
      <div class="site-header__cell-wrapper"></div>
    </div>
  </section>

  <!-- Right extreme line -->
  <div class="site-header__corner site-header__corner--right"></div>
</header>

<script>
  const toggle  = document.getElementById("lang-toggle") as HTMLButtonElement;
  const current = document.getElementById("lang-current") as HTMLSpanElement;
  const other   = document.getElementById("lang-other")   as HTMLSpanElement;

  // Read current locale from the data attribute set by Astro at build time
  const currentLang = toggle?.dataset.lang as "es" | "en";

  // Reflect current state in button labels
  if (current) current.textContent = currentLang?.toUpperCase();
  if (other)   other.textContent   = currentLang === "es" ? "EN" : "ES";

  toggle?.addEventListener("click", () => {
    toggle.classList.add("site-header__lang-btn--switching");

    const next = currentLang === "es" ? "en" : "es";

    // Navigate to the locale URL:
    // "es" (default) → "/"
    // "en"           → "/en/"
    const nextPath = next === "es" ? "/" : "/en/";

    setTimeout(() => {
      window.location.href = nextPath;
    }, 250);
  });
</script>
