---
import "../styles/header.css";
import { HEADER_NAV_LINKS, SOCIAL_LINKS } from "../data/site-config";
import type { Language } from "../data/site-config";
import CornerGrid from "../assets/corner-grid.svg";

const lang = (Astro.currentLocale ?? "es") as Language;
---

<header class="site-header">
  <!-- Left extreme line -->
  <div class="site-header__corner site-header__corner--left">
    <!-- Rounder corner grid below header -->
    <div class="site-header__rounder">
      <CornerGrid
        class="site-header__rounder-path site-header__rounder-path--flipped"
      />
      <CornerGrid class="site-header__rounder-path" />
    </div>
  </div>

  <!-- Middle content container -->
  <section class="site-header__content">
    <!-- Main navigation (Left Column - 2/3) -->
    <nav class="site-header__main-nav" aria-label="Main navigation">
      {
        HEADER_NAV_LINKS.map((link) => (
          <a
            href={link.path}
            class={`site-header__nav-link ${link.active ? "site-header__nav-link--active" : ""}`}
            role="button"
            aria-current={link.active ? "page" : undefined}
          >
            <span class="site-header__nav-text">
              <span class="site-header__nav-brackets" aria-hidden="true">
                &lt;
              </span>
              {link.name[lang]}
              <span class="site-header__nav-brackets" aria-hidden="true">
                /&gt;
              </span>
            </span>
          </a>
        ))
      }
      <!-- Empty space filler -->
      <div class="site-header__nav-filler"></div>

      <!-- Language toggle -->
      <button
        id="lang-toggle"
        class="site-header__lang-btn"
        aria-label="Switch language"
        title="Switch language / Cambiar idioma"
        data-lang={lang}
      >
        <span class="site-header__lang-current" id="lang-current">ES</span>
        <span class="site-header__lang-sep" aria-hidden="true">/</span>
        <span class="site-header__lang-other" id="lang-other">EN</span>
      </button>
    </nav>

    <!-- Social links (Right Column - 1/3) -->
    <div class="site-header__social-container">
      <nav class="site-header__social-nav" aria-label="Social links">
        {
          SOCIAL_LINKS.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="site-header__social-link"
            >
              <span class="site-header__social-icon">
                <link.icon />
              </span>
            </a>
          ))
        }
      </nav>
      <!-- Green block filling the rest of the 1/3 column -->
      <div class="site-header__social-filler"></div>

      <!-- Empty margin cell -->
      <div class="site-header__cell-wrapper"></div>
    </div>
    <!-- Rounder corner grid below header -->
    <div class="site-header__rounder">
      <CornerGrid
        class="site-header__rounder-path site-header__rounder-path--flipped"
      />
      <CornerGrid class="site-header__rounder-path" />
    </div>
    <!-- Mobile nav overlay (inside header for correct semantics) -->
    <section
      class="site-header__mobile-overlay"
      id="mobile-nav-overlay"
      aria-hidden="true"
    >
      <nav class="site-header__mobile-nav" aria-label="Mobile navigation">
        {
          HEADER_NAV_LINKS.map((link) => (
            <a
              href={link.path}
              class={`site-header__mobile-nav-link ${link.active ? "site-header__mobile-nav-link--active" : ""}`}
            >
              <span class="site-header__mobile-nav-text">
                <span class="site-header__mobile-nav-brackets" aria-hidden="true">
                  &lt;
                </span>
                {link.name[lang]}
                <span class="site-header__mobile-nav-brackets" aria-hidden="true">
                  /&gt;
                </span>
              </span>
            </a>
          ))
        }
      </nav>

      <div class="site-header__mobile-social">
        {
          SOCIAL_LINKS.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.name}
              class="site-header__mobile-social-link"
            >
              <span class="site-header__social-icon">
                <link.icon />
              </span>
              <span class="site-header__mobile-social-name">{link.name}</span>
            </a>
          ))
        }
      </div>

      <!-- Language toggle inside overlay -->
      <button
        id="lang-toggle-mobile"
        class="site-header__mobile-lang-btn"
        data-lang={lang}
      >
        <span id="lang-current-mobile">{lang.toUpperCase()}</span>
        <span aria-hidden="true"> / </span>
        <span id="lang-other-mobile">{lang === "es" ? "EN" : "ES"}</span>
      </button>
    </section>
  </section>

  <!-- Right extreme line -->
  <div class="site-header__corner site-header__corner--right">
    <!-- Rounder corner grid below header -->
    <div class="site-header__rounder">
      <CornerGrid
        class="site-header__rounder-path site-header__rounder-path--flipped"
      />
      <CornerGrid class="site-header__rounder-path" />
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("lang-toggle") as HTMLButtonElement;
  const current = document.getElementById("lang-current") as HTMLSpanElement;
  const other = document.getElementById("lang-other") as HTMLSpanElement;
  const overlay = document.getElementById("mobile-nav-overlay");

  const closeMobileOverlay = () => {
    overlay?.classList.remove("is-open");
    overlay?.setAttribute("aria-hidden", "true");
    toggle?.classList.remove("site-header__lang-btn--open");
  };

  // Read current locale from the data attribute set by Astro at build time
  const currentLang = toggle?.dataset.lang as "es" | "en";

  // Reflect current state in button labels
  if (current) current.textContent = currentLang?.toUpperCase();
  if (other) other.textContent = currentLang === "es" ? "EN" : "ES";

  toggle?.addEventListener("click", () => {
    // On mobile: toggle the overlay instead of navigating
    if (window.innerWidth < 1200) {
      const isOpen = overlay?.classList.contains("is-open");
      if (isOpen) {
        closeMobileOverlay();
      } else {
        overlay?.classList.add("is-open");
        overlay?.setAttribute("aria-hidden", "false");
        toggle.classList.add("site-header__lang-btn--open");
      }
      return;
    }

    // On desktop: switch language
    toggle.classList.add("site-header__lang-btn--switching");
    const next = currentLang === "es" ? "en" : "es";
    const nextPath = next === "es" ? "/" : "/en/";
    setTimeout(() => {
      window.location.href = nextPath;
    }, 250);
  });

  // Mobile lang toggle inside overlay
  const mobileLangBtn = document.getElementById(
    "lang-toggle-mobile",
  ) as HTMLButtonElement;
  mobileLangBtn?.addEventListener("click", () => {
    const next = currentLang === "es" ? "en" : "es";
    const nextPath = next === "es" ? "/" : "/en/";
    window.location.href = nextPath;
  });

  // Close overlay when a nav link is clicked
  document.querySelectorAll(".site-header__mobile-nav-link").forEach((link) => {
    link.addEventListener("click", closeMobileOverlay);
  });

  // Close overlay when clicking outside of overlay and toggle button
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (
      overlay?.classList.contains("is-open") &&
      !overlay.contains(target) &&
      !toggle?.contains(target)
    ) {
      closeMobileOverlay();
    }
  });
</script>
